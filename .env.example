# TEMPLATE ONLY. Copy locally to .env; never commit credentials or machine-specific data.
OWLI_MODE=mock
OWLI_HOST=127.0.0.1
OWLI_PORT=8765
# Only used with an explicitly enabled live Ollama adapter:
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_THINK=auto
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_TOTAL_TIMEOUT=60
# Optional local Piper HTTP service; no service or voice is installed or started.
OWLI_TTS_MODE=off
PIPER_BASE_URL=http://127.0.0.1:5000
PIPER_CONNECT_TIMEOUT=3
PIPER_TOTAL_TIMEOUT=60
# Legacy local TTS/STT settings (not auto-started):
PIPER_EXECUTABLE=
PIPER_VOICE_MODEL=
WHISPER_MODEL=


# Optional local speech recognition; off by default, no automatic downloads.
OWLI_STT_MODE=off
STT_MODEL_PATH=
STT_TIMEOUT=60

# Optional absolute Python executable for an existing separate STT worker environment.
STT_PYTHON=
# Diagnostics are off by default; enable both only for an explicit local measurement.
OWLI_DIAGNOSTICS=0
VITE_OWLI_DIAGNOSTICS=0
